---
import type { MarkdownHeading } from 'astro'

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props as Props
---

<h2
  id="table-of-contents-title"
  class="font-display text-sm font-medium text-gray-900 dark:text-white"
>
  Nesta página
</h2>

<ol class="mt-4 py-1 text-sm">
  {
    headings
      .filter(({ depth }) => depth > 1 && depth < 4)
      .map((heading) => (
        <li
          class={
            heading.depth == 2
              ? 'text-gray-700 dark:text-gray-300'
              : 'mt-2 py-1 pl-5 text-gray-700 dark:text-gray-300'
          }
        >
          <a class="hover:text-amber-900 dark:hover:text-amber-200" href={`#${heading.slug}`}>
            {heading.text}
          </a>
        </li>
      ))
  }
</ol>
