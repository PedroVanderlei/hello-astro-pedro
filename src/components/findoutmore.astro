---
import NotesSVG from '../assets/svg/undraw/undraw_about_me.svg'
import ChannelSVG from '../assets/svg/undraw/undraw_design_inspiration.svg'
import NetworksSVG from '../assets/svg/undraw/undraw_windows.svg'

const callouts = [
  {
    name: 'Canal',
    description: 'Séries e conversas em vídeo, em continuidade com os textos do site. (Em breve.)',
    imageSrc: ChannelSVG.src,
    imageAlt: 'Ilustração do canal',
    href: '#',
    comingSoon: true
  },
  {
    name: 'Redes',
    description:
      'Postagens curtas, recortes e avisos de publicação — sem substituir a leitura. (Em breve.)',
    imageSrc: NetworksSVG.src,
    imageAlt: 'Ilustração das redes',
    href: '#',
    comingSoon: true
  },
  {
    name: 'Apresentação',
    description:
      'O texto-base do projeto: o que este espaço é, o que não é, e como ele pretende envelhecer. (Já disponível.)',
    imageSrc: NotesSVG.src,
    imageAlt: 'Ilustração da apresentação',
    href: import.meta.env.BASE_URL + 'about',
    comingSoon: false
  }
]
---

<div class="bg-purple-100 dark:bg-purple-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl py-16 sm:py-24 lg:max-w-none lg:py-32">
      <h2 class="text-4xl font-extrabold text-purple-800 dark:text-purple-100">
        Encontrar outros caminhos
      </h2>

      <div class="mt-6 space-y-12 lg:grid lg:grid-cols-3 lg:space-y-0 lg:gap-x-6">
        {
          callouts.map((callout) => (
            <div class="group relative">
              <div class="sm:aspect-h-1 sm:aspect-w-2 lg:aspect-h-1 lg:aspect-w-1 relative h-80 w-full overflow-hidden rounded-lg bg-white group-hover:opacity-75 sm:h-64 dark:bg-purple-600">
                <img
                  src={callout.imageSrc}
                  alt={callout.imageAlt}
                  class="h-full w-full object-contain object-center"
                  loading="lazy"
                />
              </div>

              <h3 class="mt-6 text-2xl text-purple-500 dark:text-purple-300">
                <a
                  href={callout.href}
                  aria-disabled={callout.comingSoon ? 'true' : undefined}
                  tabindex={callout.comingSoon ? -1 : undefined}
                  class={callout.comingSoon ? 'cursor-not-allowed' : undefined}
                  title={callout.comingSoon ? 'Em breve' : undefined}
                >
                  <span class="absolute inset-0" />
                  {callout.name}
                </a>
              </h3>

              <p class="text-base text-gray-900 dark:text-gray-100">{callout.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
