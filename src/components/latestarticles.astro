---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Categories from '../components/categories.astro'
import { DefaultImage } from '../config'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

const newestPost = posts?.[0]
const otherPosts = posts?.slice(1, 5) ?? []

const formatDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
---

<div class="bg-white dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl py-8 sm:py-12 lg:max-w-none lg:py-16">
      <div class="flex flex-row flex-wrap items-center gap-y-2">
        <h2 class="text-2xl font-extrabold text-amber-900 md:text-4xl dark:text-amber-200">
          Em destaque
        </h2>

        <a
          href={import.meta.env.BASE_URL + 'blog'}
          class="mt-2 ml-4 inline-block rounded-md bg-amber-800 px-2 py-2 text-base font-bold text-white hover:bg-amber-700 md:px-6 md:py-3 md:text-lg dark:bg-amber-200 dark:text-gray-950 dark:hover:bg-amber-100"
        >
          Todos os textos
        </a>

        <a
          href={import.meta.env.BASE_URL + 'categories'}
          class="mt-2 ml-4 inline-block rounded-md border border-amber-200/80 bg-amber-50 px-2 py-2 text-base font-bold text-amber-900 hover:bg-amber-100 md:px-6 md:py-3 md:text-lg dark:border-amber-900/40 dark:bg-amber-200/10 dark:text-amber-100 dark:hover:bg-amber-200/15"
        >
          Temas
        </a>

        <a
          href={import.meta.env.BASE_URL + 'tags'}
          class="mt-2 ml-4 inline-block rounded-md border border-amber-200/80 bg-amber-50 px-2 py-2 text-base font-bold text-amber-900 hover:bg-amber-100 md:px-6 md:py-3 md:text-lg dark:border-amber-900/40 dark:bg-amber-200/10 dark:text-amber-100 dark:hover:bg-amber-200/15"
        >
          Rótulos
        </a>
      </div>

      <p class="mt-4 max-w-3xl text-base text-gray-700 dark:text-gray-300">
        Um ponto de entrada para retomar o fio — e, ao lado, algumas publicações recentes para quem
        prefere explorar por proximidade.
      </p>

      {
        newestPost ? (
          <div class="mt-6 space-y-12 lg:grid lg:grid-cols-2 lg:space-y-0 lg:gap-x-6 xl:grid-cols-3">
            <div class="relative mb-4 block rounded-2xl border border-amber-200/70 bg-white/80 p-4 shadow-sm transition hover:bg-white lg:mb-0 lg:p-0 xl:col-span-2 dark:border-amber-900/30 dark:bg-gray-950/40 dark:hover:bg-gray-950/55">
              <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
                <span class="sr-only">{newestPost.data.title}</span>
                {newestPost.data.coverSVG ? (
                  <img
                    src={newestPost.data.coverSVG.src}
                    alt={newestPost.data.title + ' — imagem de capa'}
                    class="h-64 w-full rounded-xl bg-amber-50 object-cover md:h-80 dark:bg-gray-900"
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={newestPost.data.coverImage || newestPost.data.socialImage || DefaultImage}
                    alt={newestPost.data.title + ' — imagem de capa'}
                    class="h-64 w-full rounded-xl bg-amber-50 object-cover md:h-80 dark:bg-gray-900"
                    loading="lazy"
                  />
                )}
              </a>

              <div class="mt-4 px-2 lg:px-6">
                {newestPost.data.categories && (
                  <Categories categories={newestPost.data.categories} />
                )}
              </div>

              <a href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}>
                <h1 class="mt-2 px-2 text-4xl leading-tight font-bold text-amber-900 hover:text-amber-800 lg:px-6 dark:text-amber-200 dark:hover:text-amber-100">
                  {newestPost.data.title}
                </h1>
              </a>

              {newestPost.data.pubDate && (
                <p class="sr-only">Publicado em {formatDate(newestPost.data.pubDate)}</p>
              )}

              <p class="mb-4 px-2 text-gray-700 lg:px-6 dark:text-gray-300">
                {newestPost.data.description}
              </p>

              <div class="px-2 pb-2 lg:px-6 lg:pb-6">
                <a
                  href={import.meta.env.BASE_URL + 'blog/' + newestPost.id}
                  class="mt-2 inline-block rounded-md bg-amber-800 px-6 py-3 text-white hover:bg-amber-700 dark:bg-amber-200 dark:text-gray-950 dark:hover:bg-amber-100"
                >
                  Abrir texto
                  <span class="sr-only">{newestPost.data.title}</span>
                </a>
              </div>
            </div>

            <div class="w-full">
              {otherPosts.map((post) => (
                <div class="mb-10 w-full rounded-2xl border border-amber-200/70 bg-white/80 p-4 shadow-sm transition hover:bg-white md:grid md:grid-cols-3 md:gap-4 dark:border-amber-900/30 dark:bg-gray-950/40 dark:hover:bg-gray-950/55">
                  <a href={new URL(import.meta.env.BASE_URL + 'blog/' + post.id, Astro.url)}>
                    {post.data.coverSVG ? (
                      <img
                        src={post.data.coverSVG.src}
                        alt={post.data.title + ' — imagem de capa'}
                        class="block h-48 w-full rounded-xl bg-amber-50 object-cover md:h-28 dark:bg-gray-900"
                        loading="lazy"
                      />
                    ) : (
                      <Image
                        src={post.data.coverImage || post.data.socialImage || DefaultImage}
                        alt={post.data.title + ' — imagem de capa'}
                        class="block h-48 w-full rounded-xl bg-amber-50 object-cover md:h-28 dark:bg-gray-900"
                        loading="lazy"
                      />
                    )}
                  </a>

                  <div class="rounded md:col-span-2">
                    {post.data.categories && <Categories categories={post.data.categories} />}

                    <a href={import.meta.env.BASE_URL + 'blog/' + post.id}>
                      <div class="mt-1 text-xl font-semibold text-gray-950 hover:text-amber-900 dark:text-gray-100 dark:hover:text-amber-100">
                        {post.data.title}
                      </div>
                    </a>

                    {post.data.pubDate && (
                      <p class="sr-only">Publicado em {formatDate(post.data.pubDate)}</p>
                    )}

                    <p class="mt-2 block text-sm text-gray-700 md:hidden dark:text-gray-300">
                      {post.data.description}
                    </p>

                    <div class="mt-4 h-px w-24 bg-gradient-to-r from-amber-700/35 to-transparent dark:from-amber-200/25" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="mt-6 rounded-2xl border border-amber-200/70 bg-amber-50/60 p-6 text-gray-800 dark:border-amber-900/30 dark:bg-gray-900 dark:text-gray-200">
            <p class="text-lg font-semibold">Ainda não há textos publicados aqui.</p>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
              Quando houver publicações, esta seção vai destacar uma entrada principal e algumas
              recentes.
            </p>
            <div class="mt-4">
              <a
                href={import.meta.env.BASE_URL + 'about'}
                class="inline-block rounded-md bg-amber-800 px-6 py-3 text-white hover:bg-amber-700 dark:bg-amber-200 dark:text-gray-950 dark:hover:bg-amber-100"
              >
                Ler a apresentação
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
