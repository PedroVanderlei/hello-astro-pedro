---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { Logo, SiteMetadata } from '../config'

const social = await getCollection('social')
---

<div class="h-24 lg:h-16"></div>
<footer class="text-gray-700 dark:text-gray-300">
  <div
    class="fixed inset-x-0 bottom-0 z-20 flex w-full flex-col items-center border-t border-amber-200/80 bg-white/85 px-4 py-1 backdrop-blur lg:flex-row lg:px-8 lg:py-4 dark:border-amber-900/40 dark:bg-gray-900/80"
  >
    <span class="flex flex-none flex-row items-center">
      <a
        class="title-font flex items-center justify-center font-medium text-gray-900 lg:justify-start dark:text-gray-50"
        href={import.meta.env.BASE_URL}
        aria-label={'Ir para a página inicial de ' + SiteMetadata.title}
      >
        <img src={Logo.src} alt={SiteMetadata.title} class="h-6 w-6 rounded-sm" loading="lazy" />
        <span class="sr-only">{SiteMetadata.title}</span>
      </a>

      <p
        class="ml-2 border-l border-amber-200/80 py-1 pl-2 text-sm text-gray-700 dark:border-amber-900/40 dark:text-gray-300"
      >
        © {new Date().getFullYear()}
        {SiteMetadata.title}
        <a
          href={import.meta.env.BASE_URL + 'about'}
          class="ml-2 text-amber-800 hover:text-amber-900 dark:text-amber-200 dark:hover:text-amber-100"
        >
          Apresentação
        </a>
      </p>
    </span>

    <span class="flex flex-none flex-row items-center">
      <p
        class="text-sm text-gray-700 lg:ml-4 lg:border-l lg:border-amber-200/80 lg:py-1 lg:pl-4 dark:text-gray-300 dark:lg:border-amber-900/40"
      >
        <a
          href={import.meta.env.BASE_URL + 'privacy'}
          class="ml-1 text-amber-800 hover:text-amber-900 dark:text-amber-200 dark:hover:text-amber-100"
        >
          Privacidade
        </a>
      </p>

      <p
        class="ml-4 border-l border-amber-200/80 py-1 pl-4 text-sm text-gray-700 dark:border-amber-900/40 dark:text-gray-300"
      >
        <a
          href={import.meta.env.BASE_URL + 'rss.xml'}
          class="ml-1 text-amber-800 hover:text-amber-900 dark:text-amber-200 dark:hover:text-amber-100"
          rel="noopener noreferrer"
          target="_blank"
        >
          RSS
        </a>
      </p>

      <p
        class="ml-4 border-l border-amber-200/80 py-1 pl-4 text-sm text-gray-700 dark:border-amber-900/40 dark:text-gray-300"
      >
        <a
          href={import.meta.env.BASE_URL + 'sitemap-index.xml'}
          class="ml-1 text-amber-800 hover:text-amber-900 dark:text-amber-200 dark:hover:text-amber-100"
          rel="noopener noreferrer"
          target="_blank"
        >
          Sitemap
        </a>
      </p>
    </span>

    <span class="mt-2 inline-flex grow justify-center lg:mt-0 lg:ml-auto lg:justify-end">
      {
        social.map((s) =>
          s.data.link ? (
            <a
              href={s.data.link}
              class="ml-3 text-amber-800 hover:text-amber-900 dark:text-amber-200 dark:hover:text-amber-100"
              rel="noopener noreferrer"
              target="_blank"
              aria-label={s.data.name}
              title={s.data.name}
            >
              <Icon name={'bi:' + s.data.icon} class="h-5 w-5" />
              <span class="sr-only">{s.data.name}</span>
            </a>
          ) : (
            ''
          )
        )
      }
    </span>
  </div>
</footer>
