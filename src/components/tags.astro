---
export interface Props {
  tags?: string[]
}

const { tags } = Astro.props
---

{
  tags && (
    <div class="mt-2 flex flex-row flex-wrap items-start gap-4 lg:gap-2">
      {tags.map((tag) => (
        <a
          href={`${import.meta.env.BASE_URL}tag/${encodeURIComponent(tag)}/`}
          class="inline-block rounded border border-amber-200/80 bg-amber-50 px-2 py-2 text-xs font-semibold text-amber-900 hover:bg-amber-100 hover:text-amber-950 lg:py-1 dark:border-amber-900/40 dark:bg-amber-200/10 dark:text-amber-100 dark:hover:bg-amber-200/15"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
