---
import { Icon } from 'astro-icon/components'

const features = [
  {
    name: 'Escrita em camadas',
    description:
      'O site reúne notas, páginas e textos mais longos num mesmo lugar. Nem tudo nasce pronto: as ideias ganham forma aos poucos, sem pressa e sem espetáculo.',
    icon: 'sparkles'
  },
  {
    name: 'Revisão como método',
    description:
      'Textos podem ser reescritos e substituídos quando amadurecem. O que aparece aqui é sempre a versão que faz sentido sustentar agora.',
    icon: 'puzzle-piece'
  },
  {
    name: 'Caminhos claros de leitura',
    description:
      'Em vez de um fluxo infinito, há portas de entrada: uma apresentação do projeto, páginas de contexto e textos publicados para quem prefere explorar por interesse.',
    icon: 'presentation-chart-bar'
  },
  {
    name: 'Ritmo de retorno',
    description:
      'Este não é um lugar de urgência. Dá para ler, parar, voltar depois — e retomar um fio pelo menu, pela busca ou por referências internas.',
    icon: 'clock'
  }
]
---

<div class="bg-amber-50/60 py-12 dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="lg:text-center">
      <h2 class="text-base font-semibold tracking-wide uppercase text-amber-900/90 dark:text-amber-200">
        Estrutura
      </h2>
      <p
        class="mt-2 text-3xl font-extrabold leading-8 tracking-tight text-gray-950 sm:text-4xl dark:text-gray-50"
      >
        Um lugar para reunir e depurar ideias
      </p>
      <p class="mt-4 max-w-2xl text-xl text-gray-700 lg:mx-auto dark:text-gray-300">
        O objetivo não é publicar rápido, nem vencer pelo volume. É organizar, testar e sustentar
        textos com clareza suficiente para serem lidos com calma.
      </p>
    </div>

    <div class="mt-10">
      <dl class="space-y-10 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-10 md:space-y-0">
        {
          features.map((feature) => (
            <div class="relative rounded-2xl border border-amber-200/70 bg-white/80 p-6 shadow-sm transition hover:bg-white dark:border-amber-900/30 dark:bg-gray-950/40 dark:hover:bg-gray-950/55">
              <dt>
                <div class="absolute -top-5 left-6 flex h-12 w-12 items-center justify-center rounded-xl bg-amber-800 text-white shadow-sm dark:bg-amber-200 dark:text-gray-950">
                  <Icon class="h-6 w-6" aria-hidden="true" name={'heroicons:' + feature.icon} />
                </div>

                <p class="pt-6 text-lg font-semibold leading-6 text-gray-950 dark:text-gray-100">
                  {feature.name}
                </p>
              </dt>

              <dd class="mt-2 text-base text-gray-700 dark:text-gray-300">
                {feature.description}
              </dd>

              <div class="mt-4 h-px w-24 bg-gradient-to-r from-amber-700/40 to-transparent dark:from-amber-200/25"></div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
