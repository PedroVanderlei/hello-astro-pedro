---
import { Icon } from 'astro-icon/components'
import { NavigationLinks, SiteMetadata, Logo } from '../config'
import Search from '../components/search.astro'
import Theme from '../components/theme.astro'
---

<div class="relative h-16 w-full">
  <nav x-data="{ isOpen: false }" class="dark:bg-gray-900" aria-label="Navegação principal">
    <div
      class="fixed z-50 mx-auto w-full border-b border-amber-200/80 bg-white/90 px-2 backdrop-blur sm:px-6 lg:px-8 dark:border-amber-900/40 dark:bg-gray-900/80"
    >
      <div class="relative flex h-16 items-center justify-between">
        <div class="absolute inset-y-0 left-0 flex items-center lg:hidden">
          <!-- Mobile menu button-->
          <button
            type="button"
            x-on:click="isOpen = !isOpen"
            x-bind:aria-expanded="isOpen"
            class="inline-flex items-center justify-center rounded-md p-2 text-amber-700 hover:bg-amber-100 hover:text-amber-900 focus:outline-none focus:ring-2 focus:ring-amber-200 focus:ring-inset dark:text-amber-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-100 dark:focus:ring-amber-900/50"
            aria-controls="mobile-menu"
          >
            <span class="sr-only">Abrir menu principal</span>
            <Icon
              x-bind:class="{'hidden': isOpen, 'block': !isOpen }"
              class="block h-6 w-6"
              aria-hidden="true"
              name="heroicons:bars-3"
            />
            <Icon
              x-bind:class="{'block': isOpen, 'hidden': !isOpen }"
              class="hidden h-6 w-6"
              aria-hidden="true"
              name="heroicons:x-mark"
            />
          </button>
        </div>

        <div class="flex flex-1 items-center justify-center lg:items-stretch lg:justify-start">
          <div class="flex shrink-0 items-center">
            <a
              href={import.meta.env.BASE_URL}
              class="flex items-center gap-2"
              aria-label={'Ir para a página inicial de ' + SiteMetadata.title}
            >
              <img
                class="block h-9 w-9 rounded-sm"
                src={Logo.src}
                alt={SiteMetadata.title}
                loading="eager"
              />
              <span class="sr-only">{SiteMetadata.title}</span>
            </a>
          </div>

          <div class="hidden lg:mx-4 lg:block">
            <div class="flex space-x-1">
              {
                NavigationLinks.map((item) => (
                  <a
                    href={import.meta.env.BASE_URL + item.href}
                    class={
                      (item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'bg-amber-100 text-amber-900 dark:bg-amber-900/30 dark:text-amber-100'
                        : 'text-amber-700 hover:bg-amber-100 hover:text-amber-900 dark:text-amber-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-100') +
                      ' rounded-md px-3 py-2 text-lg font-medium transition-colors'
                    }
                    aria-current={
                      item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div
          class="absolute inset-y-0 right-0 flex items-center pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0"
        >
          <Search />
          <Theme />
          <!-- Right nav -->
        </div>
      </div>
    </div>

    <!-- Mobile menu, show/hide based on menu state. -->
    <div
      x-show="isOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-100 transform"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-75 transform"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="absolute inset-x-0 top-16 z-50"
      id="mobile-menu"
    >
      <div
        class="flex justify-center gap-1 border-t border-b border-amber-200/80 bg-amber-50 px-4 py-2 font-semibold text-amber-900 dark:border-amber-900/40 dark:bg-gray-900 dark:text-amber-100"
      >
        {
          NavigationLinks.map((item) => (
            <a
              href={import.meta.env.BASE_URL + item.href}
              class:list={[
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'bg-amber-100 text-amber-900 dark:bg-amber-900/30 dark:text-amber-100'
                  : 'text-amber-800 hover:bg-amber-100 hover:text-amber-900 dark:text-amber-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-100',
                'rounded-md px-2 py-2 transition-colors'
              ]}
              aria-current={
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'page'
                  : undefined
              }
            >
              {item.name}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</div>
