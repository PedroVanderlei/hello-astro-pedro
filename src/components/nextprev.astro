---
import type { CollectionEntry } from 'astro:content'

export interface Props {
  base: string
  prev?: CollectionEntry<'blog'> | CollectionEntry<'doc'>
  next?: CollectionEntry<'blog'> | CollectionEntry<'doc'>
}

const { base, prev, next } = Astro.props
---

<dl class="mt-12 flex border-t border-amber-200/70 pt-6 dark:border-amber-900/40">
  {
    prev && (
      <div class="mr-auto text-left">
        <dt class="font-display text-sm font-medium text-gray-800 dark:text-gray-200">Anterior</dt>
        <dd class="mt-1">
          <a
            class="inline-flex items-center gap-2 rounded-md px-2 py-1 text-base font-semibold text-amber-900 hover:bg-amber-100/70 hover:text-amber-950 dark:text-amber-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-100"
            href={base + prev.id}
          >
            <span aria-hidden="true">←</span>
            {prev.data.title}
          </a>
        </dd>
      </div>
    )
  }

  {
    next && (
      <div class="ml-auto text-right">
        <dt class="font-display text-sm font-medium text-gray-800 dark:text-gray-200">Próximo</dt>
        <dd class="mt-1">
          <a
            class="inline-flex items-center gap-2 rounded-md px-2 py-1 text-base font-semibold text-amber-900 hover:bg-amber-100/70 hover:text-amber-950 dark:text-amber-200 dark:hover:bg-amber-900/30 dark:hover:text-amber-100"
            href={base + next.id}
          >
            {next.data.title}
            <span aria-hidden="true">→</span>
          </a>
        </dd>
      </div>
    )
  }
</dl>
