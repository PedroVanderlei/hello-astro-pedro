---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  base: string
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props as Props

const toPath = (u?: string) => (u ? new URL(u, Astro.url).pathname : undefined)

const prevHref = toPath(page.url?.prev)
const nextHref = toPath(page.url?.next)

// Alguns projetos também têm first/last — se existir, usamos; se não, caímos no base.
const firstHref = toPath(page.url?.first) ?? import.meta.env.BASE_URL + 'blog'
const lastHref = toPath(page.url?.last)
---

<div class="mt-4 flex flex-wrap items-center gap-3">
  <a
    href={import.meta.env.BASE_URL + 'categories'}
    class="rounded-md bg-amber-200/80 px-4 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-200 dark:bg-amber-900/40 dark:text-amber-100 dark:hover:bg-amber-900/55"
  >
    Temas
  </a>

  <a
    href={import.meta.env.BASE_URL + 'tags'}
    class="rounded-md bg-amber-200/60 px-4 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-200 dark:bg-amber-900/30 dark:text-amber-100 dark:hover:bg-amber-900/55"
  >
    Rótulos
  </a>

  <a
    href={import.meta.env.BASE_URL + 'authors'}
    class="rounded-md bg-amber-200/60 px-4 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-200 dark:bg-amber-900/30 dark:text-amber-100 dark:hover:bg-amber-900/55"
  >
    Autores
  </a>

  <div class="ml-auto flex items-center gap-2">
    <a
      href={firstHref}
      class="rounded-md border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-50 disabled:opacity-50 dark:border-amber-900/40 dark:bg-gray-900 dark:text-amber-200 dark:hover:bg-gray-800"
      aria-disabled={page.currentPage === 1 ? 'true' : undefined}
      tabindex={page.currentPage === 1 ? -1 : undefined}
    >
      «
    </a>

    <a
      href={prevHref}
      class="rounded-md border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-50 dark:border-amber-900/40 dark:bg-gray-900 dark:text-amber-200 dark:hover:bg-gray-800"
      aria-disabled={!prevHref ? 'true' : undefined}
      tabindex={!prevHref ? -1 : undefined}
    >
      ‹
    </a>

    <span
      class="rounded-md bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-950 dark:bg-amber-900/30 dark:text-amber-100"
    >
      {page.currentPage} / {page.lastPage}
    </span>

    <a
      href={nextHref}
      class="rounded-md border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-50 dark:border-amber-900/40 dark:bg-gray-900 dark:text-amber-200 dark:hover:bg-gray-800"
      aria-disabled={!nextHref ? 'true' : undefined}
      tabindex={!nextHref ? -1 : undefined}
    >
      ›
    </a>

    {
      lastHref && (
        <a
          href={lastHref}
          class="rounded-md border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-50 dark:border-amber-900/40 dark:bg-gray-900 dark:text-amber-200 dark:hover:bg-gray-800"
        >
          »
        </a>
      )
    }
  </div>
</div>
