---
import type { Sidebar } from '../config'

type Props = {
  currentPage: string
  sidebar: Sidebar
}

const { currentPage, sidebar } = Astro.props
const currentPageMatch = currentPage.slice(1)
---

<div
  class="hidden bg-amber-50/60 lg:sticky lg:top-16 lg:-ml-6 lg:block lg:h-[calc(100vh-4rem)] lg:flex-none lg:overflow-y-auto lg:py-16 lg:pl-6 dark:bg-gray-950"
>
  <nav aria-labelledby="grid-left" class="w-64 pr-8 text-base lg:text-sm xl:w-72 xl:pr-16">
    <ul class="space-y-9">
      {
        Object.entries(sidebar).map(([header, children]) => (
          <li>
            <div class="nav-group">
              <h2 class="font-display font-medium text-amber-950 dark:text-amber-200">{header}</h2>

              <ul class="mt-2 space-y-1 border-l-2 border-amber-200/70 lg:mt-4 lg:space-y-2 dark:border-amber-900/40">
                {children.map((child) => {
                  const url = import.meta.env.BASE_URL + child.link
                  return (
                    <li class="relative">
                      <a
                        href={url}
                        aria-current={currentPageMatch.search(child.link) >= 0 ? 'page' : false}
                        class={
                          currentPageMatch.search(child.link) >= 0
                            ? 'block w-full pl-3.5 font-semibold text-amber-950 before:pointer-events-none before:absolute before:top-1/2 before:-left-1 before:h-1.5 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-amber-700 dark:text-amber-100 dark:before:bg-amber-200'
                            : 'block w-full pl-3.5 text-gray-600 before:pointer-events-none before:absolute before:top-1/2 before:-left-1 before:hidden before:h-1.5 before:w-1.5 before:-translate-y-1/2 before:rounded-full before:bg-amber-700/60 hover:text-amber-900 hover:before:block dark:text-gray-300 dark:before:bg-amber-200/60 dark:hover:text-amber-200'
                        }
                      >
                        {child.text}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
