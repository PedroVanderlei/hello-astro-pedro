---
import { SiteMetadata } from '../config'
---

<div class="bg-amber-50/60 dark:bg-gray-950">
  <div
    class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:flex lg:items-center lg:justify-between lg:px-8 lg:py-16"
  >
    <h2 class="text-3xl font-extrabold tracking-tight text-gray-950 sm:text-4xl dark:text-gray-50">
      <span class="block">Quer começar por um caminho claro?</span>
      <span class="block text-amber-900 dark:text-amber-200">
        Leia a apresentação — ou abra um texto e siga a partir dele.
      </span>
    </h2>

    <div class="mt-8 flex lg:mt-0 lg:shrink-0">
      <div class="inline-flex rounded-md shadow-sm">
        <a
          href={import.meta.env.BASE_URL + 'about'}
          class="inline-flex items-center justify-center rounded-md border border-transparent bg-amber-800 px-5 py-3 text-base font-medium text-white hover:bg-amber-700 dark:bg-amber-200 dark:text-gray-950 dark:hover:bg-amber-100"
          aria-label={'Ler a apresentação de ' + SiteMetadata.title}
        >
          Ler a apresentação
        </a>
      </div>

      <div class="ml-4 inline-flex rounded-md shadow-sm lg:ml-3">
        <a
          href={import.meta.env.BASE_URL + 'blog'}
          class="inline-flex items-center justify-center rounded-md border border-amber-200/80 bg-white px-5 py-3 text-base font-medium text-amber-900 hover:bg-amber-50 dark:border-amber-900/40 dark:bg-amber-200/10 dark:text-amber-100 dark:hover:bg-amber-200/15"
          aria-label="Explorar textos publicados"
        >
          Explorar textos
        </a>
      </div>
    </div>
  </div>
</div>
